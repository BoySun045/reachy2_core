Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.6
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: ""
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Workspace
      Enabled: true
      Topic:
        Value: /workspace_pointcloud
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Alpha: 0.8
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: torso
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point:
        X: 0.1
        Y: -0.3
        Z: -0.1
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.5
      Target Frame: torso
      Yaw: 1.0
      Value: Orbit (rviz_default_plugins)
Window Geometry:
  Width: 1200
  Height: 800
  Displays:
    collapsed: false
  Views:
    collapsed: true
